# RabbitMQ URL used by integration tests.
# Override this in your local .env.local if needed.
AMQP_INTEGRATION_URL=amqp://mcp:discovery@127.0.0.1:5672

# RabbitMQ management API used by the least-privilege integration tests, which create a vhost and
# a broker user. Defaults: port 15672 on the broker host, with the credentials of
# AMQP_INTEGRATION_URL. The account must be an administrator. Without the API those tests skip,
# unless AMQP_INTEGRATION_REQUIRE_MANAGEMENT=1, which makes them fail instead (CI sets it).
AMQP_INTEGRATION_MANAGEMENT_URL=http://127.0.0.1:15672
# AMQP_INTEGRATION_MANAGEMENT_USERNAME=mcp
# AMQP_INTEGRATION_MANAGEMENT_PASSWORD=discovery
# AMQP_INTEGRATION_REQUIRE_MANAGEMENT=1

# RabbitMQ URL used by the end-to-end example.
# If omitted by tooling, scripts may fall back to AMQP_INTEGRATION_URL.
AMQP_EXAMPLE_URL=amqp://mcp:discovery@127.0.0.1:5672
